# Copy this file to .env.local and fill in your values
VITE_ENTRA_CLIENT_ID=          # Editor app registration client ID
VITE_ENTRA_TENANT_ID=          # Entra tenant ID
VITE_API_BASE_URL=             # Backend Functions base URL
VITE_API_SCOPE=                # Backend API scope, e.g. api://<backend-api-client-id>/.default
